---
import { herramientas, type Herramienta } from '../data/herramientas';

interface Props {
  herramientasData?: Herramienta[];
}

const { herramientasData = herramientas } = Astro.props;
---

<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- ═══ MODAL REUTILIZABLE UNIVERSAL CON VISOR DE PDF EMBEBIDO (IFRAME) ═══ -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<dialog
  id="modal-herramienta-universal"
  class="herramienta-dialog"
  aria-labelledby="dialog-title-universal"
>
  <!-- ── Botón Cerrar flotante en la esquina superior derecha del modal (siempre accesible) ── -->
  <button
    type="button"
    id="btn-cerrar-universal"
    class="btn-close-modal-floating"
    aria-label="Cerrar modal"
    title="Cerrar modal"
  >
    ✕
  </button>

  <div class="modal-dialog-inner">
    <!-- ── Encabezado del documento ── -->
    <div
      id="modal-header-scroll"
      class="px-4 sm:px-7 py-3 sm:py-4 bg-[#07192b] border-b border-dorado/30 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 pr-12 sm:pr-16 shrink-0"
    >
      <!-- Título y categoría arriba con ancho completo -->
      <div class="flex items-start sm:items-center gap-2.5 sm:gap-3 text-left w-full sm:flex-1 min-w-0">
        <span class="w-2.5 h-6 sm:h-7 bg-dorado rounded-full shrink-0 mt-0.5 sm:mt-0"></span>
        <div class="flex-1 min-w-0">
          <span
            id="modal-doc-categoria"
            class="text-dorado text-[0.68rem] sm:text-xs uppercase tracking-wider font-bold block mb-0.5 sm:mb-1"
          >
            Herramienta Legal • Documento
          </span>
          <h3
            id="dialog-title-universal"
            class="text-white text-sm sm:text-base md:text-lg font-black uppercase tracking-wide leading-snug break-words"
          >
            Documento
          </h3>
        </div>
      </div>

      <!-- Botón Descargar PDF en el encabezado -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0 w-full sm:w-auto pt-0.5 sm:pt-0">
        <button
          type="button"
          id="btn-descargar-universal"
          class="btn-herramienta-action text-xs sm:text-sm flex-1 sm:flex-none justify-center"
          title="Descargar documento en formato PDF"
        >
          <svg
            style="width: 1rem; height: 1rem; max-width: 1rem; max-height: 1rem;"
            class="shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
            ></path>
          </svg>
          <span>Descargar PDF</span>
        </button>
      </div>
    </div>

    <!-- ── Cuerpo del Modal: Visor PDF vía <iframe> ── -->
    <div class="modal-dialog-body" id="modal-iframe-container">
      <iframe
        id="modal-pdf-iframe"
        src="about:blank"
        title="Visualizador de documento PDF"
        class="modal-pdf-iframe"
        loading="lazy"
      ></iframe>
    </div>

    <!-- ── Footer fijo del Modal ── -->
    <div
      class="px-4 sm:px-7 py-2.5 sm:py-3.5 bg-[#07192b] border-t border-dorado/30 flex flex-col sm:flex-row items-center justify-between gap-2.5 sm:gap-3 shrink-0"
    >
      <p class="text-[0.68rem] sm:text-xs text-white/60 italic m-0 text-center sm:text-left order-2 sm:order-1 max-w-sm sm:max-w-md leading-tight sm:leading-normal">
        * Documento orientativo para formular presentaciones en el ámbito laboral judicial.
      </p>

      <div class="flex items-center justify-center gap-2 sm:gap-2.5 w-full sm:w-auto order-1 sm:order-2">
        <button
          type="button"
          id="btn-descargar-universal-footer"
          class="btn-herramienta-action text-xs flex-1 sm:flex-none justify-center"
          style="padding: 0.4rem 0.75rem;"
          title="Descargar documento en formato PDF"
        >
          <svg
            style="width: 0.9rem; height: 0.9rem; max-width: 0.9rem; max-height: 0.9rem;"
            class="shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
            ></path>
          </svg>
          <span>Descargar PDF</span>
        </button>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* ── Estilos para dialog nativo de herramientas ── */
  dialog.herramienta-dialog {
    position: fixed !important;
    inset: 0 !important;
    margin: auto !important;
    border: 2px solid #a6895c;
    background-color: #0c243e;
    color: #ffffff;
    border-radius: 1.25rem;
    padding: 0;
    max-width: 58rem;
    width: min(94vw, 58rem);
    height: 88vh;
    max-height: 88vh;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.85);
    overflow: hidden;
  }

  dialog.herramienta-dialog::backdrop {
    background: rgba(5, 22, 48, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  dialog.herramienta-dialog[open] {
    display: flex;
    flex-direction: column;
    animation: dialogFadeIn 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes dialogFadeIn {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .modal-dialog-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    max-height: 100%;
    overflow: hidden;
    width: 100%;
  }

  /* ── Botones de acción del modal ── */
  .btn-herramienta-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    transition: all 0.2s ease;
    cursor: pointer;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(166, 137, 92, 0.6);
  }

  .btn-herramienta-action:hover {
    background-color: #a6895c;
    color: #092646;
  }

  .btn-herramienta-action:active {
    transform: scale(0.96);
  }

  .btn-herramienta-action svg {
    width: 1rem !important;
    height: 1rem !important;
    max-width: 1rem !important;
    max-height: 1rem !important;
    flex-shrink: 0;
  }

  .btn-close-modal-floating {
    position: absolute;
    top: 0.75rem;
    right: 0.85rem;
    z-index: 50;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: 9999px;
    background: rgba(12, 36, 62, 0.92);
    border: 1px solid rgba(166, 137, 92, 0.6);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    font-weight: 700;
    transition: all 0.2s ease;
    cursor: pointer;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  @media (min-width: 640px) {
    .btn-close-modal-floating {
      top: 1rem;
      right: 1.25rem;
      width: 2.25rem;
      height: 2.25rem;
      font-size: 1.25rem;
    }
  }

  .btn-close-modal-floating:hover {
    background-color: #a6895c;
    color: #092646;
    border-color: #a6895c;
    transform: scale(1.05);
  }

  /* ── Contenedor del Visor PDF (Iframe) ── */
  .modal-dialog-body {
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    padding: 0;
    margin: 0;
    background-color: #2b2e33;
    position: relative;
  }

  .modal-pdf-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background-color: #ffffff;
  }
</style>

<!-- JSON de datos serializados para interacción en cliente -->
<script id="herramientas-datos-json" type="application/json" set:html={JSON.stringify(herramientasData)} />

<script is:inline>
  (function () {
    let activeHerramienta = null;
    let herramientasMap = {};

    function cargarDatos() {
      const scriptTag = document.getElementById('herramientas-datos-json');
      if (scriptTag) {
        try {
          const list = JSON.parse(scriptTag.textContent || '[]');
          herramientasMap = {};
          list.forEach((item) => {
            herramientasMap[item.id] = item;
          });
        } catch (e) {
          console.error('Error al parsear herramientas json:', e);
        }
      }
    }

    let savedScrollY = 0;

    function abrirModalPorId(id) {
      cargarDatos();
      const data = herramientasMap[id];
      if (!data) return;

      activeHerramienta = data;

      // Guardamos la posición exacta de scroll de la ventana antes de abrir el modal
      savedScrollY = window.scrollY || document.documentElement.scrollTop || 0;

      const modal = document.getElementById('modal-herramienta-universal');
      const catEl = document.getElementById('modal-doc-categoria');
      const titleEl = document.getElementById('dialog-title-universal');
      const iframeEl = document.getElementById('modal-pdf-iframe');

      if (catEl) catEl.textContent = data.categoria;
      if (titleEl) titleEl.textContent = data.titulo;

      if (iframeEl && data.pdfUrl) {
        // Carga directa del PDF en el iframe
        iframeEl.src = data.pdfUrl;
      }

      if (modal && typeof modal.showModal === 'function') {
        modal.showModal();
        // Evitamos que el foco del navegador mueva la página hacia arriba
        window.scrollTo({ top: savedScrollY, behavior: 'instant' });
      }
    }

    function cerrarModal() {
      const modal = document.getElementById('modal-herramienta-universal');
      const iframeEl = document.getElementById('modal-pdf-iframe');
      if (modal && typeof modal.close === 'function') {
        modal.close();
      }
      if (iframeEl) {
        // Liberamos el iframe para que no siga consumiendo memoria en background
        iframeEl.src = 'about:blank';
      }
      window.scrollTo({ top: savedScrollY, behavior: 'instant' });
    }

    function descargarPdfActivo() {
      if (!activeHerramienta || !activeHerramienta.pdfUrl) return;

      const a = document.createElement('a');
      a.href = activeHerramienta.pdfUrl;
      a.download = activeHerramienta.nombreArchivo || `${activeHerramienta.id}.pdf`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    function initModalUniversal() {
      cargarDatos();

      // Click en cualquier disparador con data-open-herramienta
      document.querySelectorAll('[data-open-herramienta]').forEach((btn) => {
        const id = btn.getAttribute('data-open-herramienta');
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          abrirModalPorId(id);
        });
        btn.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            abrirModalPorId(id);
          }
        });
      });

      // Cerrar modal
      const btnCerrar = document.getElementById('btn-cerrar-universal');
      if (btnCerrar) btnCerrar.addEventListener('click', cerrarModal);

      const modal = document.getElementById('modal-herramienta-universal');
      if (modal) {
        modal.addEventListener('click', (event) => {
          const rect = modal.getBoundingClientRect();
          const isInDialog =
            rect.top <= event.clientY &&
            event.clientY <= rect.top + rect.height &&
            rect.left <= event.clientX &&
            event.clientX <= rect.left + rect.width;
          if (!isInDialog) {
            cerrarModal();
          }
        });
        modal.addEventListener('close', () => {
          cerrarModal();
        });
      }

      // Botones de descargar PDF
      const btnDescargar = document.getElementById('btn-descargar-universal');
      if (btnDescargar) {
        btnDescargar.addEventListener('click', descargarPdfActivo);
      }
      const btnDescargarFooter = document.getElementById('btn-descargar-universal-footer');
      if (btnDescargarFooter) {
        btnDescargarFooter.addEventListener('click', descargarPdfActivo);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initModalUniversal);
    } else {
      initModalUniversal();
    }
    document.addEventListener('astro:page-load', initModalUniversal);
  })();
</script>
