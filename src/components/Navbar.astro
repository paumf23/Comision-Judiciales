---
/* Navegación principal - Comisión de Judiciales */

interface NavLink {
  label: string;
  href: string;
}

const mainLinks: NavLink[] = [
  { label: 'Inicio', href: '/' },
  { label: 'Quiénes somos', href: '/quienes-somos' },
  { label: 'Necesito ayuda ahora', href: '/necesito-ayuda' },
  { label: 'Contacto', href: '/contacto' },
];

const currentPath = Astro.url.pathname;
const isLegisActive = currentPath === '/legislacion' || currentPath === '/jurisprudencia';
---

<nav class="w-full sticky top-0 z-50" aria-label="Navegación principal">
  <!-- ═══ Fila superior: Azul marino ═══ -->
  <div class="bg-azul-marino">
    <div class="px-6 lg:px-10 py-4">

      <!-- Contenido centrado: logo + título + links (Desktop) -->
      <div class="hidden lg:flex items-center justify-center gap-6">
        <!-- Logo -->
        <a href="/" class="shrink-0" aria-label="Inicio">
          <img
            src="/LOGO.jpeg"
            alt="Logo Comisión de Judiciales"
            class="w-16 h-16 lg:w-20 lg:h-20 rounded-full object-cover"
          />
        </a>

        <!-- Título + línea + links -->
        <div class="flex flex-col">
          <!-- Título -->
          <h1 class="text-white font-semibold text-lg lg:text-xl xl:text-2xl whitespace-nowrap text-center">
            Comisión de Judiciales por un trabajo libre de violencia y acoso
          </h1>

          <!-- Línea divisoria -->
          <div class="w-full h-px bg-dorado/40 my-3"></div>

          <!-- Links principales centrados -->
          <div class="flex items-center justify-center gap-6 lg:gap-8 xl:gap-10">
            {mainLinks.filter(link => link.href !== '/necesito-ayuda').map((link) => (
              <a
                href={link.href}
                class:list={[
                  'text-sm lg:text-base xl:text-lg font-medium transition-colors duration-200 whitespace-nowrap',
                  currentPath === link.href
                    ? 'text-dorado'
                    : 'text-white/90 hover:text-dorado',
                ]}
              >
                {link.label}
              </a>
            ))}

            <!-- Botón CTA: Necesito ayuda ahora -->
            <a
              href="/necesito-ayuda"
              class="px-4 lg:px-5 py-2 bg-dorado text-azul-marino font-semibold text-sm lg:text-base xl:text-lg rounded-md hover:bg-dorado-light transition-all duration-200 hover:shadow-lg hover:shadow-dorado/20 whitespace-nowrap"
            >
              Necesito ayuda ahora
            </a>
          </div>
        </div>
      </div>

      <!-- Mobile / Tablet: logo + título + hamburguesa -->
      <div class="lg:hidden flex items-center gap-3">
        <a href="/" class="shrink-0" aria-label="Inicio">
          <img
            src="/LOGO.jpeg"
            alt="Logo Comisión de Judiciales"
            class="w-12 h-12 rounded-full object-cover"
          />
        </a>
        <p class="text-white font-semibold text-xs sm:text-sm md:text-base leading-tight flex-1">
          Comisión de Judiciales por un trabajo libre de violencia y acoso
        </p>
        <button
          id="mobile-menu-toggle"
          class="p-2 text-white/80 hover:text-white rounded-md hover:bg-white/5 transition-colors shrink-0"
          aria-label="Abrir menú"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Línea dorada separadora -->
  <div class="h-[3px] bg-dorado"></div>

  <!-- ═══ Fila inferior: Bordó ═══ -->
  <div class="bg-bordo hidden lg:block">
    <div class="px-4 lg:px-8 xl:px-10">
      <div class="flex items-center justify-center gap-1 lg:gap-2 xl:gap-4 h-11 overflow-visible">
        <!-- 1. Información útil y herramientas -->
        <a
          href="/informacion-util"
          class:list={[
            'px-2.5 lg:px-3 py-1.5 text-xs lg:text-sm xl:text-base font-medium rounded transition-colors duration-200 whitespace-nowrap',
            currentPath === '/informacion-util'
              ? 'text-dorado bg-white/10'
              : 'text-white/90 hover:text-white hover:bg-white/5',
          ]}
        >
          Información útil y herramientas
        </a>

        <!-- 2. Menú desplegable: Legislación y jurisprudencia -->
        <div class="relative group" id="legis-dropdown-container">
          <button
            type="button"
            id="legis-dropdown-btn"
            class:list={[
              'inline-flex items-center gap-1.5 px-2.5 lg:px-3 py-1.5 text-xs lg:text-sm xl:text-base font-medium rounded transition-colors duration-200 whitespace-nowrap cursor-pointer select-none',
              isLegisActive
                ? 'text-dorado bg-white/10'
                : 'text-white/90 hover:text-white hover:bg-white/5',
            ]}
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>Legislación y jurisprudencia</span>
            <svg
              class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Submenú flotante -->
          <div
            id="legis-dropdown-menu"
            class="absolute left-0 top-full pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 min-w-[210px]"
          >
            <div class="bg-azul-marino-dark/95 backdrop-blur-md border border-dorado/30 rounded-xl shadow-2xl overflow-hidden py-1.5">
              <a
                href="/legislacion"
                class:list={[
                  'flex items-center justify-between px-4 py-2.5 text-xs lg:text-sm font-medium transition-colors duration-150',
                  currentPath === '/legislacion'
                    ? 'text-dorado bg-white/10 font-semibold'
                    : 'text-white/90 hover:text-dorado hover:bg-white/5',
                ]}
              >
                <span>Legislación</span>
                <span class="text-dorado font-bold ml-2">›</span>
              </a>

              <div class="h-px bg-white/10 mx-3 my-1"></div>

              <a
                href="/jurisprudencia"
                class:list={[
                  'flex items-center justify-between px-4 py-2.5 text-xs lg:text-sm font-medium transition-colors duration-150',
                  currentPath === '/jurisprudencia'
                    ? 'text-dorado bg-white/10 font-semibold'
                    : 'text-white/90 hover:text-dorado hover:bg-white/5',
                ]}
              >
                <span>Jurisprudencia</span>
                <span class="text-dorado font-bold ml-2">›</span>
              </a>
            </div>
          </div>
        </div>

        <!-- 3. Testimonios -->
        <a
          href="/testimonios"
          class:list={[
            'px-2.5 lg:px-3 py-1.5 text-xs lg:text-sm xl:text-base font-medium rounded transition-colors duration-200 whitespace-nowrap',
            currentPath === '/testimonios'
              ? 'text-dorado bg-white/10'
              : 'text-white/90 hover:text-white hover:bg-white/5',
          ]}
        >
          Testimonios
        </a>

        <!-- 4. Proyecto de Ley -->
        <a
          href="/proyecto-de-ley"
          class:list={[
            'px-2.5 lg:px-3 py-1.5 text-xs lg:text-sm xl:text-base font-medium rounded transition-colors duration-200 whitespace-nowrap',
            currentPath === '/proyecto-de-ley'
              ? 'text-dorado bg-white/10'
              : 'text-white/90 hover:text-white hover:bg-white/5',
          ]}
        >
          Proyecto de Ley
        </a>

        <!-- 5. Blog -->
        <a
          href="/blog"
          class:list={[
            'px-2.5 lg:px-3 py-1.5 text-xs lg:text-sm xl:text-base font-medium rounded transition-colors duration-200 whitespace-nowrap',
            currentPath === '/blog'
              ? 'text-dorado bg-white/10'
              : 'text-white/90 hover:text-white hover:bg-white/5',
          ]}
        >
          Blog
        </a>

        <!-- 6. Preguntas Frecuentes -->
        <a
          href="/preguntas-frecuentes"
          class:list={[
            'px-2.5 lg:px-3 py-1.5 text-xs lg:text-sm xl:text-base font-medium rounded transition-colors duration-200 whitespace-nowrap',
            currentPath === '/preguntas-frecuentes'
              ? 'text-dorado bg-white/10'
              : 'text-white/90 hover:text-white hover:bg-white/5',
          ]}
        >
          Preguntas Frecuentes
        </a>
      </div>
    </div>
  </div>

  <!-- Línea dorada inferior -->
  <div class="h-[3px] bg-dorado hidden lg:block"></div>

  <!-- ═══ Menú móvil ═══ -->
  <div id="mobile-menu" class="lg:hidden hidden bg-azul-marino-dark border-t border-white/10">
    <div class="px-4 py-4 space-y-1">
      {mainLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'block px-4 py-3 text-sm font-medium rounded-md transition-colors duration-200',
            currentPath === link.href
              ? 'text-dorado bg-white/5'
              : 'text-white/80 hover:text-white hover:bg-white/5',
          ]}
        >
          {link.label}
        </a>
      ))}

      <!-- Links secundarios en mobile -->
      <div class="border-t border-white/10 pt-3 mt-3">
        <p class="px-4 text-xs text-dorado/60 font-semibold uppercase tracking-wider mb-2">Recursos</p>

        <!-- Información útil -->
        <a
          href="/informacion-util"
          class:list={[
            'block px-4 py-2.5 text-sm font-medium rounded-md transition-colors duration-200',
            currentPath === '/informacion-util'
              ? 'text-dorado bg-white/5'
              : 'text-white/80 hover:text-white hover:bg-white/5',
          ]}
        >
          Información útil y herramientas
        </a>

        <!-- Acordeón móvil: Legislación y jurisprudencia -->
        <div class="rounded-md overflow-hidden">
          <button
            id="mobile-legis-toggle"
            type="button"
            class:list={[
              'w-full flex items-center justify-between px-4 py-2.5 text-sm font-medium rounded-md transition-colors duration-200 cursor-pointer',
              isLegisActive
                ? 'text-dorado bg-white/5'
                : 'text-white/80 hover:text-white hover:bg-white/5',
            ]}
            aria-expanded="false"
          >
            <span>Legislación y jurisprudencia</span>
            <svg
              id="mobile-legis-arrow"
              class="w-4 h-4 transition-transform duration-200 text-dorado"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div id="mobile-legis-sub" class="hidden pl-4 pr-2 space-y-1 mt-1 border-l-2 border-dorado/40 ml-4">
            <a
              href="/legislacion"
              class:list={[
                'flex items-center justify-between px-3 py-2 text-sm rounded-md transition-colors',
                currentPath === '/legislacion'
                  ? 'text-dorado bg-white/10 font-semibold'
                  : 'text-white/70 hover:text-dorado hover:bg-white/5',
              ]}
            >
              <span>Legislación</span>
              <span class="text-dorado font-bold">›</span>
            </a>
            <a
              href="/jurisprudencia"
              class:list={[
                'flex items-center justify-between px-3 py-2 text-sm rounded-md transition-colors',
                currentPath === '/jurisprudencia'
                  ? 'text-dorado bg-white/10 font-semibold'
                  : 'text-white/70 hover:text-dorado hover:bg-white/5',
              ]}
            >
              <span>Jurisprudencia</span>
              <span class="text-dorado font-bold">›</span>
            </a>
          </div>
        </div>

        <!-- Testimonios -->
        <a
          href="/testimonios"
          class:list={[
            'block px-4 py-2.5 text-sm font-medium rounded-md transition-colors duration-200',
            currentPath === '/testimonios'
              ? 'text-dorado bg-white/5'
              : 'text-white/80 hover:text-white hover:bg-white/5',
          ]}
        >
          Testimonios
        </a>

        <!-- Proyecto de Ley -->
        <a
          href="/proyecto-de-ley"
          class:list={[
            'block px-4 py-2.5 text-sm font-medium rounded-md transition-colors duration-200',
            currentPath === '/proyecto-de-ley'
              ? 'text-dorado bg-white/5'
              : 'text-white/80 hover:text-white hover:bg-white/5',
          ]}
        >
          Proyecto de Ley
        </a>

        <!-- Blog -->
        <a
          href="/blog"
          class:list={[
            'block px-4 py-2.5 text-sm font-medium rounded-md transition-colors duration-200',
            currentPath === '/blog'
              ? 'text-dorado bg-white/5'
              : 'text-white/80 hover:text-white hover:bg-white/5',
          ]}
        >
          Blog
        </a>

        <!-- Preguntas Frecuentes -->
        <a
          href="/preguntas-frecuentes"
          class:list={[
            'block px-4 py-2.5 text-sm font-medium rounded-md transition-colors duration-200',
            currentPath === '/preguntas-frecuentes'
              ? 'text-dorado bg-white/5'
              : 'text-white/80 hover:text-white hover:bg-white/5',
          ]}
        >
          Preguntas Frecuentes
        </a>
      </div>
    </div>
  </div>
</nav>

<!-- Scripts para menú mobile y dropdowns -->
<script>
  // Mobile menu principal toggle
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');

    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');

    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
  });

  // Mobile submenú Legislación y jurisprudencia
  const mobileLegisToggle = document.getElementById('mobile-legis-toggle');
  const mobileLegisSub = document.getElementById('mobile-legis-sub');
  const mobileLegisArrow = document.getElementById('mobile-legis-arrow');

  mobileLegisToggle?.addEventListener('click', () => {
    const isExpanded = !mobileLegisSub?.classList.contains('hidden');
    mobileLegisSub?.classList.toggle('hidden');
    mobileLegisArrow?.classList.toggle('rotate-180');
    mobileLegisToggle.setAttribute('aria-expanded', String(!isExpanded));
  });

  // Desktop click toggle support (for touch screens / clicking)
  const legisDropdownBtn = document.getElementById('legis-dropdown-btn');
  const legisDropdownMenu = document.getElementById('legis-dropdown-menu');

  legisDropdownBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isVisible = legisDropdownMenu?.classList.contains('opacity-100');
    if (isVisible) {
      legisDropdownMenu?.classList.remove('opacity-100', 'visible');
      legisDropdownMenu?.classList.add('opacity-0', 'invisible');
      legisDropdownBtn.setAttribute('aria-expanded', 'false');
    } else {
      legisDropdownMenu?.classList.remove('opacity-0', 'invisible');
      legisDropdownMenu?.classList.add('opacity-100', 'visible');
      legisDropdownBtn.setAttribute('aria-expanded', 'true');
    }
  });

  document.addEventListener('click', (e) => {
    if (!legisDropdownBtn?.contains(e.target as Node)) {
      legisDropdownMenu?.classList.remove('opacity-100', 'visible');
      legisDropdownMenu?.classList.add('opacity-0', 'invisible');
      legisDropdownBtn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
