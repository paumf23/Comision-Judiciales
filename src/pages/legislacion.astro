---
import Layout from '../layouts/Layout.astro';
import normativasData from '../data/normativas-violencia-genero.json';

const { total_jurisdicciones, total_normas, jurisdicciones } = normativasData;
---

<Layout
  title="Legislación sobre Violencia de Género | Comisión de Judiciales"
  description="Sistematización de normativa sobre violencia de género por provincias y a nivel nacional. Consulte leyes, decretos y resoluciones con acceso a los textos completos en PDF."
>
  <main
    class="min-h-[calc(100vh-140px)] bg-azul-marino text-white pt-6 md:pt-10 lg:pt-12 pb-16 px-4 sm:px-8 md:px-12 lg:px-16 overflow-x-hidden w-full"
    style="font-family: 'Montserrat', sans-serif;"
  >
    <div class="w-full max-w-7xl mx-auto flex flex-col gap-6 md:gap-8">

      <!-- ═══ Encabezado ═══ -->
      <header class="text-center w-full max-w-7xl mx-auto">
        <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold tracking-wider uppercase bg-dorado/15 text-dorado border border-dorado/30 mb-4">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          LEGISALUD ARGENTINA • SISTEMATIZACIÓN NORMATIVA
        </span>

        <h1
          class="font-black text-white tracking-tight mb-4 text-center whitespace-normal md:whitespace-nowrap"
          style="font-size: clamp(1.6rem, 3.2vw, 2.9rem); line-height: 1.2; font-family: 'Montserrat', sans-serif;"
        >
          Legislación sobre <span class="text-dorado">Violencia de Género</span>
        </h1>

        <p
          class="text-white/85 text-sm sm:text-base lg:text-lg leading-relaxed max-w-5xl mx-auto"
          style="font-family: 'Montserrat', sans-serif;"
        >
          Consultá la normativa de todo el país organizada por jurisdicción. Seleccione una provincia para ver el detalle de leyes y decretos, con acceso directo a cada texto oficial en PDF.
        </p>

        <!-- Separador dorado con estilo institucional -->
        <div class="flex items-center justify-center my-6">
          <div class="h-0.5 w-16 bg-dorado/40 rounded-full"></div>
          <div class="h-1 w-24 bg-dorado mx-2 rounded-full shadow-sm shadow-dorado/50"></div>
          <div class="h-0.5 w-16 bg-dorado/40 rounded-full"></div>
        </div>

        <!-- Métricas resumidas -->
        <div class="flex items-center justify-center gap-4 sm:gap-8 text-xs sm:text-sm text-white/70">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-dorado"></span>
            <span><strong class="text-white font-semibold">{total_jurisdicciones}</strong> Jurisdicciones</span>
          </div>
          <span class="text-white/20">|</span>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-dorado"></span>
            <span><strong class="text-white font-semibold">{total_normas}</strong> Leyes y Decretos</span>
          </div>
          <span class="text-white/20">|</span>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-dorado"></span>
            <span>Textos Oficiales en PDF</span>
          </div>
        </div>
      </header>

      <!-- ═══ Panel Dividido: Dos Columnas ═══ -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start w-full">

        <!-- ── COLUMNA IZQUIERDA: Selector de Jurisdicciones ── -->
        <aside class="lg:col-span-4 xl:col-span-4 sticky top-28 z-20">
          <div class="bg-azul-marino-light/40 backdrop-blur-md border border-dorado/20 rounded-2xl p-4 sm:p-5 shadow-xl">
            
            <!-- Encabezado de la barra lateral -->
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                <svg class="w-5 h-5 text-dorado" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Jurisdicciones
              </h2>
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-dorado/15 text-dorado border border-dorado/30">
                {total_jurisdicciones}
              </span>
            </div>

            <!-- Buscador rápido de jurisdicciones -->
            <div class="relative mb-3">
              <input
                id="search-jurisdiccion"
                type="text"
                placeholder="Buscar provincia o norma..."
                class="w-full pl-9 pr-8 py-2 bg-white/5 border border-white/10 rounded-xl text-sm text-white placeholder-white/40 focus:outline-none focus:border-dorado focus:ring-1 focus:ring-dorado transition-colors"
              />
              <svg class="w-4 h-4 text-white/40 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <button
                id="clear-search"
                type="button"
                class="hidden absolute right-2.5 top-2.5 text-white/40 hover:text-white"
                title="Limpiar búsqueda"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            <!-- Lista de provincias / botones -->
            <div
              id="jurisdicciones-list"
              class="max-h-[500px] lg:max-h-[640px] overflow-y-auto space-y-1.5 pr-1 custom-scrollbar"
            >
              {jurisdicciones.map((j) => (
                <button
                  type="button"
                  data-jurisdiccion-btn={j.slug}
                  data-nombre={j.jurisdiccion.toLowerCase()}
                  class:list={[
                    'w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-left text-xs sm:text-sm font-medium transition-all duration-150 group cursor-pointer border',
                    j.slug === 'nacional'
                      ? 'is-active bg-bordo text-white border-dorado shadow-md'
                      : 'bg-white/5 hover:bg-white/10 text-white/85 hover:text-white border-transparent hover:border-dorado/30',
                  ]}
                >
                  <span class="flex items-center gap-2.5 truncate">
                    <span class="w-2 h-2 rounded-full transition-colors flex-shrink-0 bg-dorado"></span>
                    <span class="truncate">{j.jurisdiccion}</span>
                  </span>
                  <div class="flex items-center gap-2 flex-shrink-0 ml-2">
                    <span class="text-xs px-2 py-0.5 rounded-full bg-white/10 text-white/80 group-[.is-active]:bg-dorado group-[.is-active]:text-azul-marino font-semibold">
                      {j.total_normas}
                    </span>
                    <svg class="w-3.5 h-3.5 text-dorado/60 group-[.is-active]:text-dorado transition-transform group-[.is-active]:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                </button>
              ))}

              <!-- Mensaje sin resultados de búsqueda -->
              <div id="no-search-results" class="hidden text-center py-8 px-4 text-white/50 text-xs">
                No se encontraron jurisdicciones con ese término.
              </div>
            </div>

          </div>
        </aside>

        <!-- ── COLUMNA DERECHA: Listado de Normas de la Provincia ── -->
        <section id="normativas-container" class="lg:col-span-8 xl:col-span-8">
          {jurisdicciones.map((j) => (
            <article
              id={`panel-${j.slug}`}
              data-jurisdiccion-panel={j.slug}
              class:list={[
                'bg-azul-marino-light/40 backdrop-blur-md border border-dorado/20 rounded-2xl p-5 sm:p-7 shadow-xl',
                j.slug === 'nacional' ? 'block' : 'hidden',
              ]}
            >
              <!-- Cabecera del panel provincial -->
              <div class="border-b border-dorado/20 pb-5 mb-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                  <div>
                    <span class="text-xs uppercase tracking-wider font-semibold text-dorado block mb-1">
                      {j.slug === 'nacional' ? 'Normativa Federal' : 'Normativa Provincial'}
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
                      {j.jurisdiccion}
                    </h2>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-dorado/15 text-dorado border border-dorado/30">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      {j.total_normas} {j.total_normas === 1 ? 'norma disponible' : 'normas disponibles'}
                    </span>
                  </div>
                </div>
                <p class="text-xs sm:text-sm text-white/60 mt-2">
                  Hacé clic en <strong>«Ver PDF»</strong> para acceder al documento oficial digitalizado por LEGISALUD.
                </p>
              </div>

              <!-- Listado de tarjetas de normas -->
              {j.normas.length > 0 ? (
                <div class="space-y-3.5">
                  {j.normas.map((norma, idx) => (
                    <div class="bg-white/5 hover:bg-white/[0.08] border border-white/10 hover:border-dorado/40 rounded-xl p-4 sm:p-5 transition-all duration-200 group">
                      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 sm:gap-4">
                        
                        <!-- Información de la ley -->
                        <div class="flex-1">
                          <div class="flex items-center gap-2 mb-2 flex-wrap">
                            <span class="inline-block px-2.5 py-0.5 rounded-md text-xs font-bold bg-bordo/80 text-dorado border border-dorado/30 tracking-wide">
                              {norma.tipo_numero || `Norma #${idx + 1}`}
                            </span>
                          </div>

                          <p class="text-sm sm:text-base text-white/95 leading-relaxed font-normal">
                            {norma.descripcion || norma.titulo}
                          </p>
                        </div>

                        <!-- Botón para ver el PDF -->
                        <div class="sm:self-center shrink-0">
                          <a
                            href={norma.pdf_url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-4 py-2 rounded-lg bg-dorado text-azul-marino hover:bg-dorado-light font-semibold text-xs sm:text-sm transition-all duration-200 shadow-md hover:shadow-dorado/20 group/btn"
                            title={`Abrir PDF de ${norma.tipo_numero}`}
                          >
                            <!-- Icono de PDF -->
                            <svg class="w-4 h-4 shrink-0 text-azul-marino" fill="currentColor" viewBox="0 0 24 24">
                              <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9.5 8.5h-2v1h2c.28 0 .5-.22.5-.5s-.22-.5-.5-.5zm6.5 0h-1.5v3h1.5c.28 0 .5-.22.5-.5v-2c0-.28-.22-.5-.5-.5zm-4.5-2H10v5h1.5v-5zM19 19H5V5h14v14z"/>
                            </svg>
                            <span>Ver PDF</span>
                            <svg class="w-3.5 h-3.5 text-azul-marino/70 group-hover/btn:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                          </a>
                        </div>

                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="text-center py-12 text-white/50 text-sm">
                  No hay normativas registradas para esta jurisdicción.
                </div>
              )}

              <!-- Pie de información de la fuente -->
              <div class="mt-8 pt-4 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/50">
                <span class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-dorado/70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  Fuente: LEGISALUD ARGENTINA (Ministerio de Salud de la Nación)
                </span>
                <a
                  href="http://leg.msal.gov.ar/atlas/violencia_genero.html"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-dorado hover:underline inline-flex items-center gap-1"
                >
                  <span>Página original del Atlas</span>
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>

            </article>
          ))}
        </section>

      </div>

    </div>
  </main>
</Layout>

<style>
  /* Custom scrollbar para la lista de jurisdicciones */
  .custom-scrollbar::-webkit-scrollbar {
    width: 5px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 9999px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(166, 137, 92, 0.4);
    border-radius: 9999px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(166, 137, 92, 0.7);
  }
</style>

<!-- ═══ Interacción del Panel Dividido ═══ -->
<script>
  function initLegislacionPanel() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-jurisdiccion-btn]');
    const panels = document.querySelectorAll<HTMLElement>('[data-jurisdiccion-panel]');
    const searchInput = document.getElementById('search-jurisdiccion') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clear-search');
    const noResults = document.getElementById('no-search-results');

    function setActiveJurisdiccion(slug: string, updateHash = true) {
      let targetFound = false;

      // Actualizar paneles
      panels.forEach((panel) => {
        if (panel.getAttribute('data-jurisdiccion-panel') === slug) {
          panel.classList.remove('hidden');
          panel.classList.add('block');
          targetFound = true;
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('block');
        }
      });

      // Si no se encuentra el slug, fallback a 'nacional'
      if (!targetFound && slug !== 'nacional') {
        setActiveJurisdiccion('nacional', updateHash);
        return;
      }

      // Actualizar botones
      buttons.forEach((btn) => {
        const isCurrent = btn.getAttribute('data-jurisdiccion-btn') === slug;
        if (isCurrent) {
          btn.classList.add('is-active', 'bg-bordo', 'text-white', 'border-dorado', 'shadow-md');
          btn.classList.remove('bg-white/5', 'text-white/85', 'border-transparent');
          btn.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        } else {
          btn.classList.remove('is-active', 'bg-bordo', 'text-white', 'border-dorado', 'shadow-md');
          btn.classList.add('bg-white/5', 'text-white/85', 'border-transparent');
        }
      });

      // Actualizar URL hash si corresponde
      if (updateHash) {
        history.replaceState(null, '', `#${slug}`);
      }
    }

    // Event listeners para los botones
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-jurisdiccion-btn');
        if (slug) {
          setActiveJurisdiccion(slug);

          // En móviles, scrollear suavemente al inicio del panel
          if (window.innerWidth < 1024) {
            const panel = document.getElementById(`panel-${slug}`);
            if (panel) {
              const topOffset = panel.getBoundingClientRect().top + window.scrollY - 100;
              window.scrollTo({ top: topOffset, behavior: 'smooth' });
            }
          }
        }
      });
    });

    // Filtro / buscador de jurisdicciones
    searchInput?.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase().trim();

      if (query.length > 0) {
        clearBtn?.classList.remove('hidden');
      } else {
        clearBtn?.classList.add('hidden');
      }

      let visibleCount = 0;
      buttons.forEach((btn) => {
        const name = btn.getAttribute('data-nombre') || '';
        const slug = btn.getAttribute('data-jurisdiccion-btn') || '';

        // Buscar también en las normas asociadas a esa provincia
        const panel = document.getElementById(`panel-${slug}`);
        const panelText = panel ? panel.innerText.toLowerCase() : '';

        if (name.includes(query) || panelText.includes(query)) {
          btn.classList.remove('hidden');
          btn.classList.add('flex');
          visibleCount++;
        } else {
          btn.classList.add('hidden');
          btn.classList.remove('flex');
        }
      });

      if (visibleCount === 0) {
        noResults?.classList.remove('hidden');
      } else {
        noResults?.classList.add('hidden');
      }
    });

    // Limpiar búsqueda
    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.dispatchEvent(new Event('input'));
        searchInput.focus();
      }
    });

    // Al cargar la página, leer el hash de la URL
    const hash = window.location.hash.replace('#', '').trim();
    if (hash) {
      setActiveJurisdiccion(hash, false);
    } else {
      setActiveJurisdiccion('nacional', false);
    }

    // Manejar cambios en el hash del navegador (flechas atrás/adelante)
    window.addEventListener('hashchange', () => {
      const newHash = window.location.hash.replace('#', '').trim();
      if (newHash) {
        setActiveJurisdiccion(newHash, false);
      }
    });
  }

  // Inicializar al cargar
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLegislacionPanel);
  } else {
    initLegislacionPanel();
  }
</script>
