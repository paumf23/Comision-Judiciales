---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="relative min-h-fit py-10 lg:py-0 lg:aspect-[1280/486]">
    <!-- Imagen de fondo -->
    <img
      src="/fondo.jpeg"
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
    />
    <!-- Overlay claro equilibrado para óptimo contraste de texto y visibilidad de imagen -->
    <div class="absolute inset-0 bg-white/55"></div>

    <!-- Contenido del hero -->
    <div class="relative z-10 flex flex-col items-center justify-center h-full px-4 lg:px-8 py-6 lg:py-8">

      <!-- Mensaje de bienvenida -->
      <div class="text-center mb-8 max-w-7xl w-full">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-extrabold uppercase leading-tight mb-3 [text-wrap:balance]">
          <span class="text-azul-marino">Por un entorno laboral libre de </span>
          <br />
          <span class="text-bordo">violencia: dignidad y justicia</span>
        </h2>
        <p class="text-lg md:text-xl lg:text-2xl text-azul-marino font-extrabold leading-snug mb-3 max-w-6xl mx-auto [text-wrap:balance]">
          Canal oficial de la Comisión para la prevención, protección y justicia ante el acoso y maltrato laboral.
        </p>
        <p class="text-sm md:text-base lg:text-lg text-azul-marino font-semibold leading-relaxed max-w-6xl mx-auto [text-wrap:balance]">
          Sabemos que dar este paso no es fácil, pero queremos que sepas que no estás solo/a. Te ofrecemos un espacio de escucha activa, libre de juicios, con todo el respaldo humano e institucional necesario para acompañarte en cada etapa. Aquí tu voz importa y tus derechos son nuestra prioridad. Tu bienestar y dignidad son nuestro mayor compromiso.
        </p>
      </div>

      <!-- Cards -->
      <div class="flex flex-col md:flex-row items-stretch justify-center gap-6 lg:gap-8 w-full max-w-7xl">

        <!-- Card: Nuestra Misión -->
        <div class="flex-1 relative pt-10">
          <!-- Icono sobresaliente -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 z-10">
            <div class="w-20 h-20 rounded-full bg-white border-[6px] border-bordo flex items-center justify-center shadow-lg">
              <div
                class="w-10 h-10 bg-bordo"
                style="-webkit-mask: url('/balanza.png') no-repeat center / contain; mask: url('/balanza.png') no-repeat center / contain;"
              ></div>
            </div>
          </div>
          <!-- Card body -->
          <div class="bg-white/65 backdrop-blur-md rounded-lg border-[8px] border-bordo pt-12 pb-6 px-5 text-center h-full shadow-md">
            <h3 class="text-azul-marino font-extrabold text-base lg:text-lg uppercase tracking-wide mb-2">Nuestra Misión:</h3>
            <p class="text-bordo font-bold text-sm lg:text-base leading-relaxed">Garantizar el respeto y la dignidad</p>
          </div>
        </div>

        <!-- Card: Marco Legal -->
        <div class="flex-1 relative pt-10">
          <!-- Icono sobresaliente -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 z-10">
            <div class="w-20 h-20 rounded-full bg-white border-[6px] border-bordo flex items-center justify-center shadow-lg">
              <div
                class="w-10 h-10 bg-bordo"
                style="-webkit-mask: url('/marco_legal.png') no-repeat center / contain; mask: url('/marco_legal.png') no-repeat center / contain;"
              ></div>
            </div>
          </div>
          <!-- Card body -->
          <div class="bg-white/65 backdrop-blur-md rounded-lg border-[8px] border-bordo pt-12 pb-6 px-5 text-center h-full shadow-md">
            <h3 class="text-azul-marino font-extrabold text-base lg:text-lg uppercase tracking-wide mb-2">Marco Legal:</h3>
            <p class="text-bordo font-bold text-sm lg:text-base leading-relaxed">Acceda a protocolos y leyes vigentes</p>
          </div>
        </div>

        <!-- Card: Apoyo & Mediación -->
        <div class="flex-1 relative pt-10">
          <!-- Icono sobresaliente -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 z-10">
            <div class="w-20 h-20 rounded-full bg-white border-[6px] border-bordo flex items-center justify-center shadow-lg">
              <div
                class="w-10 h-10 bg-bordo"
                style="-webkit-mask: url('/personas.png') no-repeat center / contain; mask: url('/personas.png') no-repeat center / contain;"
              ></div>
            </div>
          </div>
          <!-- Card body -->
          <div class="bg-white/65 backdrop-blur-md rounded-lg border-[8px] border-bordo pt-12 pb-6 px-5 text-center h-full shadow-md">
            <h3 class="text-azul-marino font-extrabold text-base lg:text-lg uppercase tracking-wide mb-2">Apoyo & Mediación:</h3>
            <p class="text-bordo font-bold text-sm lg:text-base leading-relaxed">Canales de ayuda y seguimiento</p>
          </div>
        </div>

      </div>
    </div>
  </main>
</Layout>
