---
import Layout from "../layouts/Layout.astro";

interface FAQ {
  id: string;
  pregunta: string;
  parrafos: string[];
  items?: string[];
}

// Preguntas Frecuentes
const faqs: FAQ[] = [
  {
    id: "faq-1",
    pregunta: "¿Es seguro contactarse con la Comisión?",
    parrafos: [
      "Sí.",
      "La Comisión es un espacio independiente integrado por trabajadorxs judiciales comprometidxs con la defensa de ambientes laborales libres de violencia y acoso.",
      "Toda la información que compartas será tratada con absoluta confidencialidad y únicamente será conocida por las personas de la Comisión que intervengan en el acompañamiento, salvo que nos autorices expresamente a hacer un uso diferente de ella.",
    ],
  },
  {
    id: "faq-2",
    pregunta: "¿Contactarme con la Comisión implica hacer una denuncia?",
    parrafos: [
      "No.",
      "Podés comunicarte simplemente para hacer una consulta, recibir orientación, compartir tu experiencia o conocer cuáles son tus derechos.",
      "La decisión de denunciar o no siempre será tuya. Nuestro objetivo es brindarte información y acompañamiento para que puedas decidir libremente cómo querés avanzar.",
    ],
  },
  {
    id: "faq-3",
    pregunta: "¿Puedo contactarme aunque todavía no esté segurx de estar sufriendo violencia laboral?",
    parrafos: [
      "Sí.",
      "Muchas personas llegan con dudas porque las situaciones de violencia suelen naturalizarse o desarrollarse de manera progresiva.",
      "Si sentís malestar, miedo, hostigamiento o creés que algo no está bien en tu ambiente de trabajo, podemos ayudarte a analizar la situación.",
    ],
  },
  {
    id: "faq-4",
    pregunta: "¿Puedo comunicarme de forma anónima?",
    parrafos: [
      "Sí.",
      "Podés realizar consultas sin brindar todos tus datos personales.",
      "Si luego decidís recibir un acompañamiento más personalizado, podremos solicitarte información adicional únicamente con tu consentimiento.",
    ],
  },
  {
    id: "faq-5",
    pregunta: "¿Qué sucede después de enviar el formulario?",
    parrafos: [
      "Una vez recibido, un integrante de la Comisión analizará tu consulta y se comunicará con vos por el medio que hayas indicado, siempre respetando la confidencialidad y tus tiempos.",
      "Dependiendo de cada situación, podremos brindarte orientación, información, acompañamiento o invitarte a participar de nuestro Grupo de Apoyo Virtual.",
    ],
  },
  {
    id: "faq-6",
    pregunta: "¿La Comisión informa mi consulta a mi lugar de trabajo?",
    parrafos: [
      "No.",
      "La Comisión no comunica información a organismos públicos, empleadores, autoridades, sindicatos ni a terceras personas sin tu autorización expresa.",
      "Nuestro compromiso es proteger la privacidad de quienes se acercan a pedir ayuda.",
    ],
  },
  {
    id: "faq-7",
    pregunta: "¿La Comisión brinda patrocinio jurídico?",
    parrafos: [
      "La Comisión no reemplaza el asesoramiento profesional ni el patrocinio jurídico.",
      "Sin embargo, podemos orientarte sobre tus derechos, compartir información útil y, cuando resulte necesario, sugerirte organismos o profesionales especializados.",
    ],
  },
  {
    id: "faq-8",
    pregunta: "¿Quiénes pueden contactarse con la Comisión?",
    parrafos: [
      "La Comisión nació en el ámbito judicial y acompaña principalmente a trabajadorxs del Poder Judicial.",
      "No obstante, también recibimos consultas de trabajadorxs de otros organismos públicos y, cuando es posible, brindamos orientación o articulamos con otras organizaciones.",
    ],
  },
  {
    id: "faq-9",
    pregunta: "¿Qué es el Grupo de Apoyo Virtual?",
    parrafos: [
      "Es un espacio gratuito, confidencial y de participación voluntaria donde personas que atravesaron o atraviesan situaciones de violencia laboral pueden compartir experiencias, recibir contención y construir herramientas colectivas para afrontar estas situaciones.",
      "El grupo funciona con respeto, escucha y cuidado mutuo.",
    ],
  },
  {
    id: "faq-10",
    pregunta: "¿Qué hace la Comisión con los testimonios que recibe?",
    parrafos: [
      "Con autorización de cada persona, algunos testimonios pueden incorporarse —siempre de manera anónima— al Observatorio de Violencia Laboral o utilizarse para elaborar informes, investigaciones y campañas de sensibilización.",
      "Nuestro objetivo es visibilizar la problemática sin exponer ni revictimizar a quienes la padecen.",
    ],
  },
  {
    id: "faq-11",
    pregunta: "¿Cómo puedo colaborar con la Comisión?",
    parrafos: ["Podés colaborar de muchas maneras:"],
    items: [
      "Compartiendo tu experiencia.",
      "Participando del Grupo de Apoyo Virtual.",
      "Difundiendo nuestras actividades.",
      "Acercando materiales o investigaciones.",
      "Sumándote a las campañas y acciones de incidencia.",
      "Apoyando nuestro proyecto de ley para la implementación del Convenio 190 de la OIT.",
    ],
  },
  {
    id: "faq-12",
    pregunta: "¿Por qué la Comisión sostiene que la violencia laboral no es un problema individual?",
    parrafos: [
      "Porque entendemos que la violencia y el acoso laboral no son conflictos personales aislados, sino problemáticas que afectan derechos humanos y condiciones de trabajo. La organización colectiva, la prevención, el acompañamiento entre pares y la promoción de cambios institucionales son fundamentales para construir ámbitos laborales seguros, respetuosos y libres de violencia.",
    ],
  },
];
---

<Layout
  title="Preguntas Frecuentes - Comisión de Judiciales por un trabajo libre de violencia y acoso"
  description="Respuestas a las dudas más comunes sobre el acompañamiento, confidencialidad, denuncias y asesoramiento frente a la violencia laboral en el Poder Judicial."
>
  <main
    class="min-h-[calc(100vh-140px)] bg-azul-marino text-white pt-10 md:pt-14 pb-16 px-4 sm:px-8 md:px-12 lg:px-16 w-full overflow-x-hidden relative"
    style="font-family: 'Montserrat', sans-serif;"
  >
    <!-- Fondo decorativo sutil coherente con el resto del sitio -->
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(166,137,92,0.06)_0%,_transparent_60%)] pointer-events-none"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-full h-96 bg-[radial-gradient(circle_at_bottom_left,_rgba(83,30,72,0.20)_0%,_transparent_70%)] pointer-events-none"
    >
    </div>

    <div class="relative z-10 w-full max-w-4xl mx-auto flex flex-col gap-6 md:gap-8">
      <!-- ═══ Texto introductorio en blanco centrado (sin título) ═══ -->
      <div class="w-full text-center flex flex-col gap-3 max-w-3xl mx-auto px-2">
        <p
          class="font-medium text-base sm:text-lg md:text-xl leading-relaxed text-white/90"
        >
          Si tu duda no aparece en esta sección, podés escribirnos a través del{" "}
          <a
            href="/contacto"
            class="font-bold underline text-white hover:text-dorado transition-colors"
          >
            formulario de contacto
          </a>{" "}
          o por nuestras redes sociales.
        </p>

        <p
          class="font-black text-xl sm:text-2xl md:text-[1.5rem] text-white tracking-wide mt-1"
        >
          Estamos para escucharte y acompañarte.
        </p>
      </div>

      <!-- ═══ Acordeón de Preguntas Frecuentes con recuadros blancos y gap ═══ -->
      <section class="w-full mt-2 faq-accordion-container" aria-label="Listado de preguntas frecuentes">
        {faqs.map((faq) => (
          <details
            name="faq-accordion"
            class="faq-item group"
          >
            <!-- Cabecera / Botón de la Pregunta en recuadro blanco -->
            <summary class="faq-summary">
              <h2 class="faq-question-title">
                {faq.pregunta}
              </h2>

              <!-- Signo MÁS en azul marino (#092646) que rota a X al desplegarse -->
              <span
                class="faq-icon-plus shrink-0 ml-3"
                aria-hidden="true"
              >
                <svg
                  class="w-6 h-6 sm:w-7 sm:h-7"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#092646"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </span>
            </summary>

            <!-- Contenido / Respuesta desplegable con fondo azul más oscuro (#051630) y texto blanco -->
            <div class="faq-answer-container" lang="es">
              <div class="space-y-3.5 text-base sm:text-lg leading-relaxed text-justify hyphens-auto [text-align-last:left] [text-justify:inter-word] text-white/95">
                {faq.parrafos.map((parrafo) => (
                  <p class="m-0 text-white/95 font-normal text-justify hyphens-auto [text-align-last:left]">
                    {parrafo}
                  </p>
                ))}

                {faq.items && (
                  <ul class="space-y-2.5 my-3 text-left">
                    {faq.items.map((item) => (
                      <li class="flex flex-row items-start gap-2.5 text-white/95 font-normal">
                        <span class="text-dorado font-extrabold text-lg leading-none shrink-0" aria-hidden="true">•</span>
                        <span class="flex-1">{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </details>
        ))}
      </section>

      <!-- Espacio inferior adicional para despegue del borde de la pantalla -->
      <div style="height: 3rem;" aria-hidden="true"></div>
    </div>
  </main>
</Layout>

<style>
  /* Quitar triángulo default del summary en todos los navegadores */
  details summary::-webkit-details-marker {
    display: none;
  }
  details summary::marker {
    display: none;
  }

  /* Contenedor acordeón: preguntas con gap notorio entre cada recuadro */
  .faq-accordion-container {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 100%;
    margin-bottom: 2rem !important;
  }

  /* Cada recuadro de pregunta: tarjeta en gris notorio con esquinas redondeadas y sombra marcada */
  .faq-item {
    background-color: #cbd5e1;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.55), 0 2px 6px rgba(0, 0, 0, 0.4);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .faq-item:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.7), 0 3px 8px rgba(0, 0, 0, 0.5);
  }

  /* Cabecera / Summary */
  .faq-summary {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 1rem;
    padding: 1rem 1.25rem !important;
    cursor: pointer;
    list-style: none;
    user-select: none;
    background-color: #cbd5e1;
    color: #092646;
  }

  @media (min-width: 640px) {
    .faq-summary {
      padding: 1.15rem 1.5rem !important;
    }
  }

  .faq-question-title {
    margin: 0;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.98rem;
    font-weight: 700;
    color: #092646;
    line-height: 1.4;
    text-align: left;
    flex: 1;
  }

  @media (min-width: 640px) {
    .faq-question-title {
      font-size: 1.05rem;
    }
  }


  /* Signo MÁS en azul marino que rota a X al abrirse */
  .faq-icon-plus {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.28s ease;
    flex-shrink: 0;
  }

  details[open] .faq-icon-plus {
    transform: rotate(45deg);
  }

  /* Contenedor de la respuesta con tono dorado intermedio (#d8c49a) */
  .faq-answer-container {
    padding: 1.25rem 1.25rem 1.5rem 1.25rem !important;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    background-color: #051630 !important;
    color: #ffffff;
    text-align: justify;
    text-justify: inter-word;
    text-align-last: left;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  @media (min-width: 640px) {
    .faq-answer-container {
      padding: 1.4rem 1.5rem 1.75rem 1.5rem !important;
    }
  }

  /* Animación suave de aparición */
  details[open] > .faq-answer-container {
    animation: fadeInSlide 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeInSlide {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script is:inline>
  // En navegadores que no cierran automáticamente los detalles con el mismo name
  function initAccordion() {
    const allDetails = document.querySelectorAll('details[name="faq-accordion"]');
    allDetails.forEach((targetDetail) => {
      targetDetail.addEventListener('toggle', () => {
        if (targetDetail.open) {
          allDetails.forEach((otherDetail) => {
            if (otherDetail !== targetDetail && otherDetail.open) {
              otherDetail.open = false;
            }
          });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAccordion);
  } else {
    initAccordion();
  }
  document.addEventListener('astro:page-load', initAccordion);
</script>
